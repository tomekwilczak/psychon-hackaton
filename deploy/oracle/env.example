# Skopiuj jako deploy/oracle/.env WYŁĄCZNIE na serwerze.
# Ten plik nie zawiera prawdziwych sekretów.
STAGING_DOMAIN=psychon.mgmurski.pl
DB_DATABASE=niepodzielni
DB_USERNAME=niepodzielni
DB_PASSWORD=UZUPELNIJ_LOSOWYM_HASLEM
APP_KEY=base64:UZUPELNIJ_KLUCZEM_LARAVEL

# Format: login:hash bcrypt. Wartość generuje skrypt bootstrap-server.sh.
BASIC_AUTH_CREDENTIALS=psychon:UZUPELNIJ_HASHEM_BCRYPT

# Mailpit jest dostępny wyłącznie przez tunel SSH na localhost VPS-a.
NP_MAILPIT_PORT=8025
